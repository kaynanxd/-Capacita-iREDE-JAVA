<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.irede.taskmanager.controller.TarefaFormController"
      spacing="18" prefWidth="480" prefHeight="350" styleClass="formulario">
    <padding><Insets top="24" right="24" bottom="24" left="24" /></padding>
    <Label text="Dados da tarefa" styleClass="titulo-formulario" />
    <GridPane hgap="12" vgap="12">
        <Label text="Título" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="campoTitulo" promptText="Ex.: Estudar JDBC" prefWidth="350"
                   GridPane.rowIndex="0" GridPane.columnIndex="1" />
        <Label text="Descrição" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <TextArea fx:id="campoDescricao" promptText="Detalhes da tarefa" wrapText="true"
                  prefRowCount="5" GridPane.rowIndex="1" GridPane.columnIndex="1" />
        <CheckBox fx:id="campoConcluida" text="Tarefa concluída"
                  GridPane.rowIndex="2" GridPane.columnIndex="1" />
    </GridPane>
    <Label fx:id="mensagemErro" wrapText="true" styleClass="mensagem-erro" />
    <HBox spacing="10">
        <Button text="Salvar" onAction="#salvar" styleClass="botao-primario" />
        <Button text="Cancelar" onAction="#cancelar" />
    </HBox>
</VBox>

